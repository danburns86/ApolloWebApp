    }

    private async Task CascadeTimingsToExisting()
    {
        if (prod == null || !prod.Performances.Any()) return;
        
        // 1. Calculate the exact durations from your default clock times
        int firstHalfMins = (int)(calcIntervalStart - calcStartTime).TotalMinutes;
        if (firstHalfMins < 0) firstHalfMins += 1440;
        
        var intervalEndClock = calcIntervalStart.AddMinutes(calcIntervalMins);
        int secondHalfMins = (int)(calcEndTime - intervalEndClock).TotalMinutes;
        if (secondHalfMins < 0) secondHalfMins += 1440;

        using var context = await DbFactory.CreateDbContextAsync();
        var dbProd = await context.Productions.Include(p => p.Performances).FirstAsync(p => p.Id == id);

        // 2. Loop through every existing show and rebuild its timings based on its unique CurtainUp time
        foreach (var perf in dbProd.Performances)
        {
            perf.IntervalTime = perf.CurtainUp.AddMinutes(firstHalfMins);
            perf.EndTime = perf.IntervalTime.Value.AddMinutes(calcIntervalMins + secondHalfMins);
        }
        
        dbProd.IntervalMinutes = calcIntervalMins;
        dbProd.RunningTimeMinutes = firstHalfMins + secondHalfMins;

        await context.SaveChangesAsync();
        await LoadData();
    }
