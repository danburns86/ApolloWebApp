@code {
    [Parameter] public int id { get; set; }
    private Production? prod;
    private bool isLoading = true;
    private string activeTab = "performances";
    private string calendarMode = "agenda";
    private string scheduleFilter = "all";
    private DateTime currentCalendarMonth = DateTime.Today;

    // Logistics Calculator
    private TimeOnly calcStartTime = new TimeOnly(19, 30);
    private TimeOnly calcIntervalStart = new TimeOnly(20, 45);
    private int calcIntervalMins = 20;
    private TimeOnly calcEndTime = new TimeOnly(22, 30);

    private List<Member> allMembers = new();
    private List<Member> showRosterMembers = new();
    private List<Room> availableRooms = new();
    private List<ProductionEventType> eventTypes = new();
    private List<ProductionCast> prodCastList = new();
    private List<ProductionUnavailability> unavailabilityList = new();
    
    private Dictionary<int, string> castInputName = new();
    private Dictionary<int, string> castUnderstudyInputName = new();
    private Dictionary<int, string> crewInputName = new();
    private Dictionary<int, string> crewDepInputName = new();
    private string unlockingInputName = "";
    private string lockingInputName = "";
    private string naInputName = "";

    // Perf Modal
    private bool showPerfModal = false;
    private Performance newPerf = new();
    private DateTime newPerfDate = DateTime.Today;
    private TimeOnly newPerfStartTime = new TimeOnly(19, 30);
    private TimeOnly newPerfIntervalStart = new TimeOnly(20, 45);
    private int newPerfIntervalMins = 20;
    private TimeOnly newPerfEndTime = new TimeOnly(22, 30);

    private bool showPerfOverridesModal = false;
    private Performance? selectedPerfForOverrides;
    private string overrideModalTab = "cast";

    private bool showEventModal = false;
    private bool isTechEventModal = false;
    private ProductionEvent newEvent = new();

    private bool showNaModal = false;
    private ProductionUnavailability newNa = new();

    // Generator Fields
    private DateTime genStartDate = DateTime.Today;
    private DateTime genEndDate = DateTime.Today.AddDays(30);
    private TimeOnly genStartTime = new TimeOnly(19, 0);
    private TimeOnly genEndTime = new TimeOnly(22, 0);
    private int genEventTypeId = 0;
    private string genLocation = "";
    private Dictionary<DayOfWeek, bool> genDays = new()
    {
        { DayOfWeek.Monday, false }, { DayOfWeek.Tuesday, true }, { DayOfWeek.Wednesday, false },
        { DayOfWeek.Thursday, true }, { DayOfWeek.Friday, false }, { DayOfWeek.Saturday, false }, { DayOfWeek.Sunday, false }
    };

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData()
    {
        isLoading = true;
        using var context = await DbFactory.CreateDbContextAsync();

        prod = await context.Productions
            .Include(p => p.Category).Include(p => p.UnlockingMember).Include(p => p.LockingMember)
            .Include(p => p.Performances).ThenInclude(perf => perf.Overrides).ThenInclude(o => o.Member)
            .Include(p => p.Events).ThenInclude(e => e.EventType)
            .Include(p => p.CrewAssignments).ThenInclude(c => c.Role).Include(p => p.CrewAssignments).ThenInclude(c => c.Member).Include(p => p.CrewAssignments).ThenInclude(c => c.DepMember)
            .FirstOrDefaultAsync(p => p.Id == id);

        if (prod != null)
        {
            allMembers = await context.Members.OrderBy(m => m.LastName).ThenBy(m => m.FirstName).ToListAsync();
            availableRooms = await context.Rooms.Where(r => r.IsActive).ToListAsync();
            eventTypes = await context.Set<ProductionEventType>().ToListAsync();
            prodCastList = await context.ProductionCasts.Include(c => c.Member).Include(c => c.DepMember).Where(c => c.ProductionId == id).ToListAsync();
            unavailabilityList = await context.Set<ProductionUnavailability>().Include(u => u.Member).Where(u => u.ProductionId == id).ToListAsync();

            InitializeCalcFromProd();
            unlockingInputName = prod.UnlockingMember?.FullName ?? "";
            lockingInputName = prod.LockingMember?.FullName ?? "";

            var rosterIds = prod.CrewAssignments.Select(c => c.MemberId).Union(prod.CrewAssignments.Select(c => c.DepMemberId)).Union(prodCastList.Select(c => c.MemberId)).Union(prodCastList.Select(c => c.DepMemberId)).Where(i => i.HasValue).Select(i => i!.Value).ToHashSet();
            showRosterMembers = allMembers.Where(m => rosterIds.Contains(m.Id)).ToList();

            foreach (var cast in prodCastList) { castInputName[cast.Id] = cast.Member?.FullName ?? cast.ExternalName ?? ""; castUnderstudyInputName[cast.Id] = cast.DepMember?.FullName ?? ""; }
            foreach (var crew in prod.CrewAssignments) { crewInputName[crew.Id] = crew.Member?.FullName ?? crew.ExternalName ?? ""; crewDepInputName[crew.Id] = crew.DepMember?.FullName ?? ""; }
        }
        isLoading = false;
    }

    private void InitializeCalcFromProd()
    {
        if (prod == null) return;
        calcStartTime = new TimeOnly(19, 30);
        int firstHalf = prod.RunningTimeMinutes > 0 ? prod.RunningTimeMinutes / 2 : 75;
        calcIntervalStart = calcStartTime.AddMinutes(firstHalf);
        calcIntervalMins = prod.IntervalMinutes > 0 ? prod.IntervalMinutes : 20;
        calcEndTime = calcIntervalStart.AddMinutes(calcIntervalMins + (prod.RunningTimeMinutes - firstHalf));
    }

    private void RecalculateRunningTimeFromClock()
    {
        if (prod == null) return;
        int firstHalf = (int)(calcIntervalStart - calcStartTime).TotalMinutes;
        if (firstHalf < 0) firstHalf += 1440;
        var intEnd = calcIntervalStart.AddMinutes(calcIntervalMins);
        int secondHalf = (int)(calcEndTime - intEnd).TotalMinutes;
        if (secondHalf < 0) secondHalf += 1440;

        prod.RunningTimeMinutes = firstHalf + secondHalf;
        prod.IntervalMinutes = calcIntervalMins;
    }

    private void OpenAddPerformanceModal()
    {
        newPerf = new Performance { ProductionId = id };
        newPerfDate = DateTime.Today;
        newPerfStartTime = calcStartTime;
        newPerfIntervalStart = calcIntervalStart;
        newPerfIntervalMins = calcIntervalMins;
        newPerfEndTime = calcEndTime;
        showPerfModal = true;
    }

    private async Task SavePerformance()
    {
        newPerf.CurtainUp = newPerfDate.Add(newPerfStartTime.ToTimeSpan());
        newPerf.IntervalTime = newPerfDate.Add(newPerfIntervalStart.ToTimeSpan());
        newPerf.EndTime = newPerfDate.Add(newPerfEndTime.ToTimeSpan());

        if (newPerf.IntervalTime < newPerf.CurtainUp) newPerf.IntervalTime = newPerf.IntervalTime.Value.AddDays(1);
        if (newPerf.EndTime < newPerf.IntervalTime) newPerf.EndTime = newPerf.EndTime.Value.AddDays(1);

        using var context = await DbFactory.CreateDbContextAsync();
        context.Performances.Add(newPerf);
        await context.SaveChangesAsync();
        showPerfModal = false;
        await LoadData();
    }
    
    private async Task DeletePerformance(Performance perf)
    {
        using var context = await DbFactory.CreateDbContextAsync();
        context.Performances.Remove(perf);
        await context.SaveChangesAsync();
        await LoadData();
    }

    private void OpenPerformanceOverridesModal(Performance perf)
    {
        selectedPerfForOverrides = perf;
        overrideModalTab = "cast";
        showPerfOverridesModal = true;
    }

    private (int? memberId, bool isReal) GetOrCreateMember(string input, ApplicationDbContext ctx)
    {
        if (string.IsNullOrWhiteSpace(input)) return (null, false);
        var val = input.Trim();
        var match = allMembers.FirstOrDefault(m => m.FullName.Equals(val, StringComparison.OrdinalIgnoreCase));
        if (match != null) return (match.Id, true);

        var name = val.StartsWith("*") ? val.Substring(1).Trim() : val;
        var parts = name.Split(' ', 2);
        var m = new Member { FirstName = "*" + (parts.Length > 0 ? parts[0] : "Temp"), LastName = parts.Length > 1 ? parts[1] : "Member", IsTemporaryPlaceholder = true };
        ctx.Members.Add(m);
        ctx.SaveChanges();
        allMembers.Add(m);
        return (m.Id, true);
    }

    private async Task ResolveCastName(ProductionCast cast) { using var ctx = await DbFactory.CreateDbContextAsync(); var res = GetOrCreateMember(castInputName[cast.Id], ctx); cast.MemberId = res.memberId; cast.ExternalName = res.isReal ? null : castInputName[cast.Id]; await SaveCast(cast); }
    private async Task ResolveCastUnderstudyName(ProductionCast cast) { using var ctx = await DbFactory.CreateDbContextAsync(); cast.DepMemberId = GetOrCreateMember(castUnderstudyInputName[cast.Id], ctx).memberId; await SaveCast(cast); }
    private async Task ResolveCrewName(ProductionCrew crew) { using var ctx = await DbFactory.CreateDbContextAsync(); var res = GetOrCreateMember(crewInputName[crew.Id], ctx); crew.MemberId = res.memberId; crew.ExternalName = res.isReal ? null : crewInputName[crew.Id]; await SaveCrew(crew); }
    private async Task ResolveCrewDepName(ProductionCrew crew) { using var ctx = await DbFactory.CreateDbContextAsync(); crew.DepMemberId = GetOrCreateMember(crewDepInputName[crew.Id], ctx).memberId; await SaveCrew(crew); }
    private async Task ResolveUnlockingKeyholder() { if (prod != null) { using var ctx = await DbFactory.CreateDbContextAsync(); prod.UnlockingMemberId = GetOrCreateMember(unlockingInputName, ctx).memberId; } }
    private async Task ResolveLockingKeyholder() { if (prod != null) { using var ctx = await DbFactory.CreateDbContextAsync(); prod.LockingMemberId = GetOrCreateMember(lockingInputName, ctx).memberId; } }
    private async Task ResolveNaMember() { using var ctx = await DbFactory.CreateDbContextAsync(); newNa.MemberId = GetOrCreateMember(naInputName, ctx).memberId ?? 0; }

    private async Task SaveCastOverride(string charName, string? name) { using var ctx = await DbFactory.CreateDbContextAsync(); var perf = await ctx.Performances.Include(p => p.Overrides).FirstAsync(p => p.Id == selectedPerfForOverrides!.Id); var ex = perf.Overrides.FirstOrDefault(o => o.CustomRoleName == charName); if (string.IsNullOrWhiteSpace(name)) { if (ex != null) ctx.Remove(ex); } else { var res = GetOrCreateMember(name, ctx); if (ex == null) { ex = new PerformanceCrewOverride { PerformanceId = perf.Id, CustomRoleName = charName }; ctx.Add(ex); } if (res.isReal) { ex.MemberId = res.memberId; ex.ExternalName = null; } else { ex.ExternalName = name; ex.MemberId = null; } } await ctx.SaveChangesAsync(); await LoadData(); }
    private async Task SaveCrewOverride(int? roleId, string custRole, string? name) { using var ctx = await DbFactory.CreateDbContextAsync(); var perf = await ctx.Performances.Include(p => p.Overrides).FirstAsync(p => p.Id == selectedPerfForOverrides!.Id); var ex = perf.Overrides.FirstOrDefault(o => (roleId.HasValue && o.RoleId == roleId) || (!roleId.HasValue && o.CustomRoleName == custRole)); if (string.IsNullOrWhiteSpace(name)) { if (ex != null) ctx.Remove(ex); } else { var res = GetOrCreateMember(name, ctx); if (ex == null) { ex = new PerformanceCrewOverride { PerformanceId = perf.Id, RoleId = roleId, CustomRoleName = custRole }; ctx.Add(ex); } if (res.isReal) { ex.MemberId = res.memberId; ex.ExternalName = null; } else { ex.ExternalName = name; ex.MemberId = null; } } await ctx.SaveChangesAsync(); await LoadData(); }

    private async Task SaveProd() { if (prod == null) return; using var ctx = await DbFactory.CreateDbContextAsync(); ctx.Productions.Update(prod); await ctx.SaveChangesAsync(); }
    private async Task SaveCast(ProductionCast cast) { using var ctx = await DbFactory.CreateDbContextAsync(); ctx.ProductionCasts.Update(cast); await ctx.SaveChangesAsync(); await LoadData(); }
    private async Task SaveCrew(ProductionCrew crew) { using var ctx = await DbFactory.CreateDbContextAsync(); ctx.ProductionCrews.Update(crew); await ctx.SaveChangesAsync(); await LoadData(); }
    private async Task DeleteCast(ProductionCast cast) { using var ctx = await DbFactory.CreateDbContextAsync(); ctx.ProductionCasts.Remove(cast); await ctx.SaveChangesAsync(); await LoadData(); }
    private void OpenAddNaModal() { newNa = new ProductionUnavailability { ProductionId = id, StartDateTime = DateTime.Today.AddHours(9), EndDateTime = DateTime.Today.AddHours(22) }; showNaModal = true; naInputName = ""; }
    private async Task SaveNA() { if (newNa.MemberId == 0) return; using var ctx = await DbFactory.CreateDbContextAsync(); ctx.Add(newNa); await ctx.SaveChangesAsync(); showNaModal = false; await LoadData(); }
    private async Task DeleteNA(ProductionUnavailability na) { using var ctx = await DbFactory.CreateDbContextAsync(); ctx.Remove(na); await ctx.SaveChangesAsync(); await LoadData(); }
    
    private IEnumerable<ProductionEvent> GetFilteredEvents()
    {
        if (prod == null) return Enumerable.Empty<ProductionEvent>();
        var query = prod.Events.AsEnumerable();
        if (scheduleFilter == "rehearsal") query = query.Where(e => !e.IsCastNotRequired);
        else if (scheduleFilter == "tech") query = query.Where(e => e.IsTechnicalDate);
        return query.OrderBy(e => e.StartTime);
    }
    
    private void OpenAddEventModal(bool isTech)
    {
        isTechEventModal = isTech;
        newEvent = new ProductionEvent { ProductionId = id, StartTime = DateTime.Today.AddHours(19), EndTime = DateTime.Today.AddHours(22), IsTechnicalDate = isTech, IsCastNotRequired = isTech };
        showEventModal = true;
    }
    
    private void OnEventTypeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int typeId))
        {
            newEvent.EventTypeId = typeId;
            var selectedType = eventTypes.FirstOrDefault(et => et.Id == typeId);
            if (selectedType != null)
            {
                newEvent.IsTechnicalDate = selectedType.DefaultToTechSchedule;
                newEvent.IsCastNotRequired = !selectedType.DefaultToRehearsalSchedule;
            }
        }
    }

    private async Task SaveEvent()
    {
        using var context = await DbFactory.CreateDbContextAsync();
        context.ProductionEvents.Add(newEvent);
        await context.SaveChangesAsync();
        showEventModal = false;
        await LoadData();
    }

    private async Task DeleteEvent(ProductionEvent ev)
    {
        using var context = await DbFactory.CreateDbContextAsync();
        context.ProductionEvents.Remove(ev);
        await context.SaveChangesAsync();
        await LoadData();
    }

    private async Task GenerateSchedule()
    {
        using var context = await DbFactory.CreateDbContextAsync();
        var selectedType = eventTypes.FirstOrDefault(et => et.Id == genEventTypeId);

        for (var date = genStartDate.Date; date <= genEndDate.Date; date = date.AddDays(1))
        {
            if (genDays[date.DayOfWeek])
            {
                context.ProductionEvents.Add(new ProductionEvent
                {
                    ProductionId = id,
                    EventTypeId = genEventTypeId > 0 ? genEventTypeId : null,
                    StartTime = date.Add(genStartTime.ToTimeSpan()),
                    EndTime = date.Add(genEndTime.ToTimeSpan()),
                    Location = genLocation,
                    IsTechnicalDate = selectedType?.DefaultToTechSchedule ?? false,
                    IsCastNotRequired = !(selectedType?.DefaultToRehearsalSchedule ?? true),
                    ShowOnSchedule = true
                });
            }
        }
        await context.SaveChangesAsync();
        activeTab = "schedule";
        await LoadData();
    }

    private void PrevMonth() => currentCalendarMonth = currentCalendarMonth.AddMonths(-1);
    private void NextMonth() => currentCalendarMonth = currentCalendarMonth.AddMonths(1);

    private List<List<DateTime>> GetMonthWeeks()
    {
        var weeks = new List<List<DateTime>>();
        var firstDayOfMonth = new DateTime(currentCalendarMonth.Year, currentCalendarMonth.Month, 1);
        var startDay = firstDayOfMonth.AddDays(-((int)firstDayOfMonth.DayOfWeek == 0 ? 6 : (int)firstDayOfMonth.DayOfWeek - 1));

        var currentDay = startDay;
        for (int w = 0; w < 5; w++)
        {
            var week = new List<DateTime>();
            for (int d = 0; d < 7; d++)
            {
                week.Add(currentDay);
                currentDay = currentDay.AddDays(1);
            }
            weeks.Add(week);
        }
        return weeks;
    }

