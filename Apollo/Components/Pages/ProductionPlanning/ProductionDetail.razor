@page "/admin/production/hub/{id:int}"
@using Apollo.Models
@using Apollo.Data
@using Microsoft.EntityFrameworkCore
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NavigationManager Nav
@inject IJSRuntime JS
@rendermode InteractiveServer

<PageTitle>Production Hub - @(prod?.Title ?? "Loading...")</PageTitle>

@if (isLoading)
{
    <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
}
else if (prod == null)
{
    <div class="alert alert-danger m-4">Production not found.</div>
}
else
{
    <!-- UNIVERSAL MEMBER & NON-MEMBER DATALIST -->
    <datalist id="allMembersList">
        @foreach (var m in allMembers)
        {
            <option value="@m.FullName">@(m.IsTemporaryPlaceholder ? "Non-Member" : m.Email)</option>
        }
    </datalist>

    <div class="container-fluid px-4 py-4 max-w-7xl">
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3 bg-white p-4 rounded-3 border shadow-sm">
            <div>
                <a href="/admin/production" class="text-decoration-none small text-muted"><i class="bi bi-arrow-left me-1"></i>Back to Production List</a>
                <h2 class="fw-bold mb-0 text-dark">@prod.Title</h2>
                <span class="badge bg-dark mt-1">@prod.Category?.Name</span>
                <span class="text-muted ms-2 small">@prod.StartDate.ToString("dd MMM yyyy") - @prod.EndDate.ToString("dd MMM yyyy")</span>
            </div>
            <div class="d-flex gap-2">
                <a href="@($"/admin/production/signin/{prod.Id}")" class="btn btn-success fw-bold"><i class="bi bi-clipboard-check me-2"></i>Live Register & Call Sheet</a>
                <a href="/reports/Production/FoHBriefing" class="btn btn-outline-primary fw-bold"><i class="bi bi-file-earmark-text me-2"></i>FOH Sheet</a>
            </div>
        </div>

        <ul class="nav nav-pills mb-4 bg-light p-2 rounded-3 border fw-bold flex-wrap gap-1">
            <li class="nav-item"><button class="nav-link @(activeTab == "performances" ? "active" : "")" @onclick='() => activeTab = "performances"'><i class="bi bi-ticket-perforated me-2"></i>Performances & Times</button></li>
            <li class="nav-item"><button class="nav-link @(activeTab == "schedule" ? "active" : "")" @onclick='() => activeTab = "schedule"'><i class="bi bi-calendar3 me-2"></i>Schedule</button></li>
            <li class="nav-item"><button class="nav-link @(activeTab == "generator" ? "active" : "")" @onclick='() => activeTab = "generator"'><i class="bi bi-magic me-2"></i>Batch Generator</button></li>
            <li class="nav-item"><button class="nav-link @(activeTab == "castcrew" ? "active" : "")" @onclick='() => activeTab = "castcrew"'><i class="bi bi-people me-2"></i>Cast & Crew Roster</button></li>
            <li class="nav-item"><button class="nav-link @(activeTab == "unavailability" ? "active" : "")" @onclick='() => activeTab = "unavailability"'><i class="bi bi-calendar-x me-2"></i>NA Matrix</button></li>
            <li class="nav-item"><button class="nav-link @(activeTab == "warnings" ? "active" : "")" @onclick='() => activeTab = "warnings"'><i class="bi bi-shield-exclamation me-2"></i>Warnings</button></li>
            <li class="nav-item"><button class="nav-link @(activeTab == "logistics" ? "active" : "")" @onclick='() => activeTab = "logistics"'><i class="bi bi-clock-history me-2"></i>Timings & Spec</button></li>
        </ul>

        <!-- TAB 1: PERFORMANCES -->
        @if (activeTab == "performances")
        {
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
                    <h6 class="fw-bold mb-0 text-primary"><i class="bi bi-ticket-perforated me-2"></i>Show Schedule & Exact Clock Timings</h6>
                    <button class="btn btn-sm btn-primary fw-bold" @onclick="OpenAddPerformanceModal"><i class="bi bi-plus-lg me-1"></i>Add Show Date</button>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-light small text-uppercase">
                                <tr>
                                    <th class="ps-4">Date</th>
                                    <th class="text-center">Start</th>
                                    <th class="text-center">Interval Start</th>
                                    <th class="text-center">Show End</th>
                                    <th>Title / Note</th>
                                    <th class="text-center">Active Covers</th>
                                    <th class="text-end pe-4">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var perf in prod.Performances.OrderBy(p => p.CurtainUp))
                                {
                                    var coverCount = perf.Overrides?.Count ?? 0;
                                    var intervalStart = perf.IntervalTime ?? perf.CurtainUp.AddMinutes(75);
                                    var showEnd = perf.EndTime ?? intervalStart.AddMinutes(prod.IntervalMinutes > 0 ? prod.IntervalMinutes + 55 : 75);

                                    <tr>
                                        <td class="ps-4 fw-bold">@perf.CurtainUp.ToString("ddd dd MMM yyyy")</td>
                                        <td class="text-center fw-bold text-dark fs-6">@perf.CurtainUp.ToString("HH:mm")</td>
                                        <td class="text-center fw-bold text-primary fs-6">@intervalStart.ToString("HH:mm")</td>
                                        <td class="text-center fw-bold text-success fs-6">@showEnd.ToString("HH:mm")</td>
                                        <td><span class="badge bg-secondary">@(string.IsNullOrEmpty(perf.PerformanceTitle) ? "Standard Show" : perf.PerformanceTitle)</span></td>
                                        <td class="text-center">
                                            <button class="btn btn-sm @(coverCount > 0 ? "btn-warning text-dark fw-bold" : "btn-outline-secondary")" @onclick="() => OpenPerformanceOverridesModal(perf)">
                                                <i class="bi bi-person-up me-1"></i>@(coverCount > 0 ? $"{coverCount} Cover(s)" : "Manage Covers")
                                            </button>
                                        </td>
                                        <td class="text-end pe-4">
                                            <button class="btn btn-sm text-danger" @onclick="() => DeletePerformance(perf)"><i class="bi bi-trash"></i></button>
                                        </td>
                                    </tr>
                                }
                                @if (!prod.Performances.Any())
                                {
                                    <tr><td colspan="7" class="text-center py-4 text-muted fst-italic">No performances set.</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }

        <!-- TAB 2: SCHEDULE & CALENDAR -->
        @if (activeTab == "schedule")
        {
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white d-flex flex-wrap justify-content-between align-items-center gap-2 py-3">
                    <div class="d-flex align-items-center gap-3">
                        <div class="btn-group">
                            <button class="btn btn-sm btn-outline-secondary @(calendarMode == "agenda" ? "active" : "")" @onclick='() => calendarMode = "agenda"'><i class="bi bi-list-task me-1"></i>Agenda</button>
                            <button class="btn btn-sm btn-outline-secondary @(calendarMode == "month" ? "active" : "")" @onclick='() => calendarMode = "month"'><i class="bi bi-calendar-month me-1"></i>Month</button>
                        </div>
                        <div class="btn-group btn-group-sm">
                            <button class="btn @(scheduleFilter == "all" ? "btn-dark" : "btn-outline-dark")" @onclick='() => scheduleFilter = "all"'>All Events</button>
                            <button class="btn @(scheduleFilter == "rehearsal" ? "btn-secondary" : "btn-outline-secondary")" @onclick='() => scheduleFilter = "rehearsal"'>Rehearsals</button>
                            <button class="btn @(scheduleFilter == "tech" ? "btn-primary" : "btn-outline-primary")" @onclick='() => scheduleFilter = "tech"'>Tech</button>
                        </div>
                    </div>
                    <div class="d-flex gap-2">
                        <button class="btn btn-sm btn-outline-primary fw-bold" @onclick='() => OpenAddEventModal(false)'><i class="bi bi-plus-lg me-1"></i>Add Rehearsal</button>
                        <button class="btn btn-sm btn-primary fw-bold" @onclick='() => OpenAddEventModal(true)'><i class="bi bi-tools me-1"></i>Add Tech</button>
                    </div>
                </div>
                <div class="card-body p-0">
                    @if (calendarMode == "agenda")
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="bg-light small">
                                    <tr>
                                        <th class="ps-4">Date & Time</th>
                                        <th>Type</th>
                                        <th>Location</th>
                                        <th>Cast Called</th>
                                        <th>Notes</th>
                                        <th class="text-end pe-4">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var ev in GetFilteredEvents())
                                    {
                                        <tr>
                                            <td class="ps-4 fw-bold">@ev.StartTime.ToString("ddd dd MMM HH:mm") - @ev.EndTime.ToString("HH:mm")</td>
                                            <td><span class="badge @(ev.IsTechnicalDate ? "bg-primary" : "bg-dark")">@(ev.EventType?.Name ?? "Event")</span></td>
                                            <td>@ev.Location</td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(ev.CharactersRequired))
                                                {
                                                    <span class="badge bg-info text-dark">@ev.CharactersRequired</span>
                                                }
                                                else if (ev.IsCastNotRequired)
                                                {

                                                    <span class="badge bg-light text-muted border">None</span>
                                                }
                                                else
                                                {

                                                    <span class="badge bg-secondary">All Called</span>
                                                }
                                            </td>
                                            <td class="small">@ev.Notes</td>
                                            <td class="text-end pe-4"><button class="btn btn-sm text-danger" @onclick="() => DeleteEvent(ev)"><i class="bi bi-trash"></i></button></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="p-4">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <button class="btn btn-sm btn-outline-dark" @onclick="PrevMonth"><i class="bi bi-chevron-left"></i> Prev</button>
                                <h5 class="fw-bold mb-0">@currentCalendarMonth.ToString("MMMM yyyy")</h5>
                                <button class="btn btn-sm btn-outline-dark" @onclick="NextMonth">Next <i class="bi bi-chevron-right"></i></button>
                            </div>
                            <div class="row g-1 text-center fw-bold bg-light py-2 border rounded-top">
                                <div class="col">Mon</div><div class="col">Tue</div><div class="col">Wed</div><div class="col">Thu</div><div class="col">Fri</div><div class="col">Sat</div><div class="col">Sun</div>
                            </div>
                            <div class="month-grid border border-top-0 rounded-bottom">
                                @foreach (var week in GetMonthWeeks())
                                {
                                    <div class="row g-1 border-bottom min-h-100">
                                        @foreach (var day in week)
                                        {
                                            <div class="col p-2 border-end text-start @(day.Month != currentCalendarMonth.Month ? "bg-light opacity-50" : "bg-white")" style="min-height: 110px;">
                                                <div class="fw-bold small mb-1 text-muted">@day.Day</div>
                                                @foreach (var perf in prod.Performances.Where(p => p.CurtainUp.Date == day.Date))
                                                {
                                                    <div class="badge bg-danger text-wrap text-start w-100 mb-1 p-1"><i class="bi bi-ticket-perforated me-1"></i>@perf.CurtainUp.ToString("HH:mm") Show</div>
                                                }
                                                @foreach (var ev in GetFilteredEvents().Where(e => e.StartTime.Date == day.Date))
                                                {
                                                    <div class="badge @(ev.IsTechnicalDate ? "bg-primary" : "bg-dark") text-wrap text-start w-100 mb-1 p-1">@ev.StartTime.ToString("HH:mm") @(ev.EventType?.Name ?? "Event")</div>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        <!-- TAB 3: GENERATOR -->
        @if (activeTab == "generator")
        {
            <div class="card border-0 shadow-sm p-4">
                <h5 class="fw-bold mb-3 text-primary"><i class="bi bi-magic me-2"></i>Recurring Rehearsal Generator</h5>
                <div class="row g-3">
                    <div class="col-md-6"><label class="form-label small fw-bold">From</label><input type="date" class="form-control" @bind="genStartDate" /></div>
                    <div class="col-md-6"><label class="form-label small fw-bold">To</label><input type="date" class="form-control" @bind="genEndDate" /></div>
                    <div class="col-md-6"><label class="form-label small fw-bold">Start Time</label><input type="time" class="form-control" @bind="genStartTime" /></div>
                    <div class="col-md-6"><label class="form-label small fw-bold">End Time</label><input type="time" class="form-control" @bind="genEndTime" /></div>
                    <div class="col-md-6">
                        <label class="form-label small fw-bold">Type</label>
                        <select class="form-select" @bind="genEventTypeId">
                            @foreach (var et in eventTypes)
                            {
                                <option value="@et.Id">@et.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-bold">Location</label>
                        <input type="text" class="form-control" list="genRooms" @bind="genLocation" />
                        <datalist id="genRooms">@foreach (var r in availableRooms) {
                            <option value="@r.Name"></option>
                        }
                    </datalist>
                </div>
                <div class="col-12">
                    <div class="d-flex gap-3 mt-2">
                        <div class="form-check"><input class="form-check-input" type="checkbox" @bind="genDays[DayOfWeek.Monday]" /><label class="form-check-label fw-bold">Mon</label></div>
                        <div class="form-check"><input class="form-check-input" type="checkbox" @bind="genDays[DayOfWeek.Tuesday]" /><label class="form-check-label fw-bold">Tue</label></div>
                        <div class="form-check"><input class="form-check-input" type="checkbox" @bind="genDays[DayOfWeek.Wednesday]" /><label class="form-check-label fw-bold">Wed</label></div>
                        <div class="form-check"><input class="form-check-input" type="checkbox" @bind="genDays[DayOfWeek.Thursday]" /><label class="form-check-label fw-bold">Thu</label></div>
                        <div class="form-check"><input class="form-check-input" type="checkbox" @bind="genDays[DayOfWeek.Friday]" /><label class="form-check-label fw-bold">Fri</label></div>
                        <div class="form-check"><input class="form-check-input" type="checkbox" @bind="genDays[DayOfWeek.Saturday]" /><label class="form-check-label fw-bold">Sat</label></div>
                        <div class="form-check"><input class="form-check-input" type="checkbox" @bind="genDays[DayOfWeek.Sunday]" /><label class="form-check-label fw-bold">Sun</label></div>
                    </div>
                </div>
            </div>
            <div class="mt-4 text-end"><button class="btn btn-success px-4 fw-bold" @onclick="GenerateSchedule">Generate Recurring</button></div>
        </div>
    }

    <!-- TAB 4: CAST & CREW ROSTER -->
    @if (activeTab == "castcrew")
    {
        <div class="row g-4">
            <div class="col-lg-6">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center py-3">
                        <h6 class="fw-bold mb-0">Cast & Understudies</h6>
                        <button class="btn btn-sm btn-light fw-bold" @onclick="AddCastRow">Add Character</button>
                    </div>
                    <div class="card-body p-0">
                        <table class="table table-hover align-middle mb-0 small">
                            <thead class="bg-light">
                                <tr>
                                    <th class="ps-3" style="width: 25%;">Character</th>
                                    <th style="width: 30%;">Actor (Search)</th>
                                    <th style="width: 30%;">Master Understudy (Search)</th>
                                    <th style="width: 15%;">Script #</th>
                                    <th class="text-end pe-3">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var cast in prodCastList)
                                {
                                    <tr>
                                        <td class="ps-3 fw-bold"><input type="text" class="form-control form-control-sm fw-bold" @bind="cast.CharacterName" @bind:after="() => SaveCast(cast)" /></td>
                                        <td><input type="text" class="form-control form-control-sm" list="allMembersList" placeholder="Search..." @bind="castInputName[cast.Id]" @bind:after="() => ResolveCastName(cast)" /></td>
                                        <td><input type="text" class="form-control form-control-sm" list="allMembersList" placeholder="Search..." @bind="castUnderstudyInputName[cast.Id]" @bind:after="() => ResolveCastUnderstudyName(cast)" /></td>
                                        <td><input type="text" class="form-control form-control-sm" @bind="cast.ScriptNumber" @bind:after="() => SaveCast(cast)" /></td>
                                        <td class="text-end pe-3"><button class="btn btn-sm text-danger" @onclick="() => DeleteCast(cast)"><i class="bi bi-trash"></i></button></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center py-3">
                        <h6 class="fw-bold mb-0">Technical Crew & Deps</h6>
                    </div>
                    <div class="card-body p-0">
                        <table class="table table-hover align-middle mb-0 small">
                            <thead class="bg-light">
                                <tr>
                                    <th class="ps-3" style="width: 25%;">Role</th>
                                    <th style="width: 30%;">Assignee (Search)</th>
                                    <th style="width: 30%;">Master Dep (Search)</th>
                                    <th style="width: 15%;">Script #</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var crew in prod.CrewAssignments)
                                {
                                    <tr>
                                        <td class="ps-3 fw-bold">@(crew.Role?.Name ?? crew.CustomRoleName)</td>
                                        <td><input type="text" class="form-control form-control-sm" list="allMembersList" placeholder="Search..." @bind="crewInputName[crew.Id]" @bind:after="() => ResolveCrewName(crew)" /></td>
                                        <td><input type="text" class="form-control form-control-sm" list="allMembersList" placeholder="Search..." @bind="crewDepInputName[crew.Id]" @bind:after="() => ResolveCrewDepName(crew)" /></td>
                                        <td><input type="text" class="form-control form-control-sm" @bind="crew.ScriptNumber" @bind:after="() => SaveCrew(crew)" /></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- TAB 5: UNAVAILABILITY -->
    @if (activeTab == "unavailability")
    {
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
                <h6 class="fw-bold mb-0 text-danger"><i class="bi bi-calendar-x me-2"></i>Cast & Crew NA Dates</h6>
                <button class="btn btn-sm btn-danger fw-bold shadow-sm" @onclick="OpenAddNaModal"><i class="bi bi-plus-lg me-1"></i>Add Unavailability</button>
            </div>
            <div class="card-body p-0">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light small">
                        <tr>
                            <th class="ps-4">Person</th>
                            <th>From Date & Time</th>
                            <th>To Date & Time</th>
                            <th>Reason</th>
                            <th class="text-end pe-4">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var na in unavailabilityList)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-primary">@na.Member?.FullName</td>
                                <td>@na.StartDateTime.ToString("ddd dd MMM yyyy - HH:mm")</td>
                                <td>@na.EndDateTime.ToString("ddd dd MMM yyyy - HH:mm")</td>
                                <td class="text-muted">@na.Reason</td>
                                <td class="text-end pe-4"><button class="btn btn-sm text-danger" @onclick="() => DeleteNA(na)"><i class="bi bi-trash"></i></button></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <!-- TAB 6: WARNINGS -->
    @if (activeTab == "warnings")
    {
        <div class="card border-0 shadow-sm p-4">
            <h5 class="fw-bold mb-3 text-primary"><i class="bi bi-shield-exclamation me-2"></i>Show Content Warnings Grid</h5>
            <div class="row g-3">
                <div class="col-md-4"><div class="form-check form-switch"><input class="form-check-input" type="checkbox" @bind="prod.WarnSmokeHaze" /><label class="form-check-label fw-bold">Smoke / Haze Effects</label></div></div>
                <div class="col-md-4"><div class="form-check form-switch"><input class="form-check-input" type="checkbox" @bind="prod.WarnFlashingLights" /><label class="form-check-label fw-bold">Flashing Lights / Strobe</label></div></div>
                <div class="col-md-4"><div class="form-check form-switch"><input class="form-check-input" type="checkbox" @bind="prod.WarnGunshotsPyros" /><label class="form-check-label fw-bold">Gunshots / Pyrotechnics</label></div></div>
                <div class="col-md-4"><div class="form-check form-switch"><input class="form-check-input" type="checkbox" @bind="prod.WarnLoudNoises" /><label class="form-check-label fw-bold">Sudden Loud Noises</label></div></div>
                <div class="col-md-4"><div class="form-check form-switch"><input class="form-check-input" type="checkbox" @bind="prod.WarnSexualContent" /><label class="form-check-label fw-bold">Sexual Content / Nudity</label></div></div>
                <div class="col-md-4"><div class="form-check form-switch"><input class="form-check-input" type="checkbox" @bind="prod.WarnViolenceGore" /><label class="form-check-label fw-bold">Violence / Gore</label></div></div>
                <div class="col-md-4"><div class="form-check form-switch"><input class="form-check-input" type="checkbox" @bind="prod.WarnDistressingThemes" /><label class="form-check-label fw-bold">Distressing Themes</label></div></div>
                <div class="col-md-4"><div class="form-check form-switch"><input class="form-check-input" type="checkbox" @bind="prod.WarnStageSmoking" /><label class="form-check-label fw-bold">Stage Smoking</label></div></div>
                <div class="col-md-4"><div class="form-check form-switch"><input class="form-check-input" type="checkbox" @bind="prod.WarnAudienceInteraction" /><label class="form-check-label fw-bold">Audience Interaction</label></div></div>
            </div>
            <div class="mt-4 pt-3 border-top">
                <label class="form-label fw-bold">Adult Language</label>
                <select class="form-select" @bind="prod.WarnAdultLanguageLevel">
                    <option value="0">None</option>
                    <option value="1">Infrequent</option>
                    <option value="2">Frequent</option>
                </select>
            </div>
            <div class="mt-4"><label class="form-label fw-bold small">Custom Notes</label><textarea class="form-control" rows="2" @bind="prod.CustomContentWarnings"></textarea></div>
            <div class="mt-4 text-end"><button class="btn btn-primary px-4 fw-bold" @onclick="SaveProd">Save Warnings</button></div>
        </div>
    }

    <!-- TAB 7: TIMINGS, LOGISTICS & TECH NOTES (CLOCK CALCULATOR) -->
    @if (activeTab == "logistics")
    {
        <div class="card border-0 shadow-sm p-4">
            <h5 class="fw-bold mb-3 text-primary"><i class="bi bi-clock me-2"></i>Default Clock Timings Calculator</h5>
            <p class="small text-muted mb-3">Enter the default clock times. These calculate the minutes used to prepopulate new performance rows.</p>
            <div class="row g-3 mb-4 bg-light p-3 rounded border">
                <div class="col-md-3">
                    <label class="form-label small fw-bold">Typical Start Time</label>
                    <input type="time" class="form-control fw-bold" @bind="calcStartTime" @bind:after="RecalculateRunningTimeFromClock" />
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-bold">Interval Start Time</label>
                    <input type="time" class="form-control fw-bold" @bind="calcIntervalStart" @bind:after="RecalculateRunningTimeFromClock" />
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-bold">Interval Duration (Mins)</label>
                    <input type="number" class="form-control fw-bold" @bind="calcIntervalMins" @bind:after="RecalculateRunningTimeFromClock" />
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-bold">Typical End Time</label>
                    <input type="time" class="form-control fw-bold" @bind="calcEndTime" @bind:after="RecalculateRunningTimeFromClock" />
                </div>
                    
                    <div class="col-12 mt-2">
                        <div class="d-flex flex-wrap align-items-center justify-content-between p-3 border border-success bg-success-subtle rounded small fw-bold">
                            <span class="text-success fs-6"><i class="bi bi-info-circle me-2"></i>Calculated Show Run Time (excluding interval): @prod.RunningTimeMinutes mins</span>
                            <button class="btn btn-sm btn-success fw-bold shadow-sm" @onclick="CascadeTimingsToExisting">
                                <i class="bi bi-arrow-down-square me-1"></i>Apply Durations to Existing Show Dates
                            </button>
                        </div>
                    </div>

                <div class="col-12 mt-3">
                    <label class="form-label small fw-bold">FOH / Audience Notes</label>
                    <textarea class="form-control" rows="2" @bind="prod.FOHNotes"></textarea>
                </div>
            </div>

            <h5 class="fw-bold mb-3 text-primary"><i class="bi bi-gear-wide-connected me-2"></i>Technical Requirements & Hire Details</h5>
            <div class="row g-3 mb-4">
                <div class="col-md-6"><label class="form-label small fw-bold">Hirer Name</label><input type="text" class="form-control" @bind="prod.HirerName" /></div>
                <div class="col-md-6"><label class="form-label small fw-bold">Hirer Contact</label><input type="text" class="form-control" @bind="prod.HirerContact" /></div>
                <div class="col-md-6"><label class="form-label small fw-bold">Access / Load-In</label><input type="datetime-local" class="form-control" @bind="prod.AccessTime" /></div>
                <div class="col-md-6 d-flex align-items-end"><div class="form-check form-switch mb-2"><input class="form-check-input" type="checkbox" @bind="prod.OurCrew" id="ourCrewCheck" /><label class="form-check-label fw-bold" for="ourCrewCheck">In-House Crew?</label></div></div>
                <div class="col-12"><label class="form-label small fw-bold">Technical Requirements</label><textarea class="form-control" rows="3" @bind="prod.TechRequirements"></textarea></div>
            </div>

            <h5 class="fw-bold mb-3 pt-3 border-top"><i class="bi bi-key me-2"></i>Building Security & Keyholders</h5>
            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label class="form-label small fw-bold">Unlocking Keyholder</label>
                    <input type="text" class="form-control" list="allMembersList" placeholder="Search keyholder..." @bind="unlockingInputName" @bind:after="ResolveUnlockingKeyholder" />
                </div>
                <div class="col-md-6">
                    <label class="form-label small fw-bold">Locking Keyholder</label>
                    <input type="text" class="form-control" list="allMembersList" placeholder="Search keyholder..." @bind="lockingInputName" @bind:after="ResolveLockingKeyholder" />
                </div>
            </div>
            <div class="text-end"><button class="btn btn-primary px-4 fw-bold" @onclick="SaveProd">Save Timings & Logistics</button></div>
        </div>
    }
</div>
}

