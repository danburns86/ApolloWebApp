@page "/reports/Production/Gaps"
@using Apollo.Models
@using Apollo.Data
@using Microsoft.EntityFrameworkCore
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject IJSRuntime JS
@rendermode InteractiveServer

<div class="container py-4 max-w-6xl d-print-none">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0 text-danger"><i class="bi bi-person-exclamation me-2"></i>Crew Gaps Report</h2>
            <p class="text-muted mb-0">Identify mandatory technical roles missing assignments.</p>
        </div>
        <button class="btn btn-outline-dark fw-bold" @onclick="Print"><i class="bi bi-printer me-2"></i>Print Report</button>
    </div>

    <div class="card border-0 shadow-sm bg-light mb-4">
        <div class="card-body row g-3 align-items-end">
            <div class="col-md-4">
                <label class="small fw-bold">From Date</label>
                <input type="date" class="form-control" @bind="dateFrom" @bind:after="LoadGaps" />
            </div>
            <div class="col-md-4">
                <label class="small fw-bold">To Date</label>
                <input type="date" class="form-control" @bind="dateTo" @bind:after="LoadGaps" />
            </div>
            <div class="col-md-4">
                <button class="btn btn-dark w-100 fw-bold" @onclick="LoadGaps">Filter Gaps</button>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-danger text-white small">
                    <tr>
                        <th class="ps-4">Production</th>
                        <th>Show Dates</th>
                        <th>Missing Required Role</th>
                        <th>Category</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var gap in gapList)
                    {
                        <tr>
                            <td class="ps-4 fw-bold">@gap.ProductionTitle</td>
                            <td class="small text-muted">@gap.StartDate.ToString("dd MMM yyyy") - @gap.EndDate.ToString("dd MMM yyyy")</td>
                            <td><span class="badge bg-danger fs-6">@gap.RoleName</span></td>
                            <td>@gap.CategoryName</td>
                        </tr>
                    }
                    @if (!gapList.Any())
                    {
                        <tr><td colspan="4" class="text-center py-4 text-success fw-bold">All mandatory crew roles are fully assigned across the selected dates!</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    private DateTime dateFrom = DateTime.Today;
    private DateTime dateTo = DateTime.Today.AddDays(60);
    private List<CrewGapRecord> gapList = new();

    protected override async Task OnInitializedAsync() => await LoadGaps();

    private async Task LoadGaps()
    {
        using var context = await DbFactory.CreateDbContextAsync();
        gapList.Clear();

        var crews = await context.ProductionCrews
            .Include(c => c.Production).ThenInclude(p => p!.Category)
            .Include(c => c.Role)
            .Where(c => c.IsRequired && c.MemberId == null && string.IsNullOrEmpty(c.ExternalName) && c.Production != null && c.Production.StartDate >= dateFrom && c.Production.StartDate <= dateTo && !c.Production.IsArchived)
            .ToListAsync();

        foreach (var c in crews)
        {
            gapList.Add(new CrewGapRecord
            {
                ProductionTitle = c.Production?.Title ?? "",
                StartDate = c.Production?.StartDate ?? DateTime.Today,
                EndDate = c.Production?.EndDate ?? DateTime.Today,
                RoleName = c.Role?.Name ?? c.CustomRoleName ?? "Required Crew",
                CategoryName = c.Production?.Category?.Name ?? ""
            });
        }
    }

    private async Task Print() => await JS.InvokeVoidAsync("window.print");

    public class CrewGapRecord
    {
        public string ProductionTitle { get; set; } = string.Empty;
        public DateTime StartDate { get; set; }
        public DateTime EndDate { get; set; }
        public string RoleName { get; set; } = string.Empty;
        public string CategoryName { get; set; } = string.Empty;
    }
}