@page "/reports/Production/SeasonView"
@using Apollo.Models
@using Apollo.Data
@using Microsoft.EntityFrameworkCore
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject IJSRuntime JS
@rendermode InteractiveServer

<PageTitle>Season Overview</PageTitle>

<div class="container py-4 max-w-7xl d-print-none">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
            <h2 class="fw-bold mb-0 text-primary"><i class="bi bi-calendar2-range me-2"></i>Season Overview</h2>
            <p class="text-muted mb-0">High-level filtered view of all active productions and operational statuses.</p>
        </div>
        
        <!-- EXPORT & PRINT BUTTONS -->
        <div class="d-flex gap-2 flex-wrap">
            <button class="btn btn-outline-success fw-bold" @onclick="ExportToExcel"><i class="bi bi-file-earmark-excel me-1"></i>Excel</button>
            <button class="btn btn-outline-primary fw-bold" @onclick="ExportToWord"><i class="bi bi-file-earmark-word me-1"></i>Word</button>
            <button class="btn btn-outline-danger fw-bold" @onclick="Print"><i class="bi bi-file-earmark-pdf me-1"></i>PDF</button>
            <button class="btn btn-dark fw-bold" @onclick="Print"><i class="bi bi-printer me-1"></i>Print</button>
        </div>
    </div>

    <!-- CONTROLS CONTAINER (Hidden on Print) -->
    <div class="card border-0 shadow-sm mb-4 bg-light p-3 d-print-none">
        <div class="row g-3 align-items-center">
            <!-- VIEW MODES -->
            <div class="col-md-5">
                <label class="small fw-bold text-muted text-uppercase d-block mb-1">Report View Mode</label>
                <div class="btn-group shadow-sm w-100">
                    <button class="btn @(currentView == "headlines" ? "btn-dark" : "btn-outline-dark") fw-bold" @onclick='() => currentView = "headlines"'>Headlines</button>
                    <button class="btn @(currentView == "crewing" ? "btn-dark" : "btn-outline-dark") fw-bold" @onclick='() => currentView = "crewing"'>Crewing</button>
                    <button class="btn @(currentView == "logistics" ? "btn-dark" : "btn-outline-dark") fw-bold" @onclick='() => currentView = "logistics"'>Logistics</button>
                </div>
            </div>

            <!-- CATEGORY FILTER CHECKBOXES -->
            <div class="col-md-7">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <label class="small fw-bold text-muted text-uppercase">Filter Categories</label>
                    <div>
                        <button class="btn btn-link btn-sm p-0 me-2 text-decoration-none fw-bold" @onclick="SelectAllCategories">Select All</button>
                        <button class="btn btn-link btn-sm p-0 text-decoration-none text-muted fw-bold" @onclick="ClearAllCategories">Clear</button>
                    </div>
                </div>
                <div class="d-flex flex-wrap gap-3 bg-white p-2 rounded border">
                    @foreach (var cat in allCategories)
                    {
                        var isChecked = selectedCategoryIds.Contains(cat.Id);
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" checked="@isChecked" @onchange="(e) => ToggleCategory(cat.Id, e.Value)" id="@($"cat_{cat.Id}")" />
                            <label class="form-check-label small fw-bold" for="@($"cat_{cat.Id}")">@cat.Name</label>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
    }
    else
    {
        <div id="seasonReportContent" class="card border-0 shadow-sm print-area bg-white">
            <div class="d-none d-print-block p-4 border-bottom mb-3">
                <h2 class="fw-bold mb-0">Season Overview Report</h2>
                <p class="text-muted small mb-0">Generated on @DateTime.Now.ToString("dd MMM yyyy")</p>
            </div>
            
            <div class="card-body p-0">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light small text-uppercase">
                        <tr>
                            <th class="ps-4" style="width: 25%;">Production</th>
                            <th style="width: 20%;">Run Dates</th>
                            
                            @if (currentView == "headlines")
                            {
                                <th>Category</th>
                                <th>Show Count</th>
                                <th>Status</th>
                            }
                            else if (currentView == "crewing")
                            {
                                <th>Required Roles Filled</th>
                                <th>Total Crew Assigned</th>
                                <th class="text-center">Action Required?</th>
                            }
                            else if (currentView == "logistics")
                            {
                                <th>Hirer / Co.</th>
                                <th>Running Time</th>
                                <th>Locking Keyholder</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var prod in GetFilteredProductions())
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-dark fs-6">@prod.Title</td>
                                <td>@prod.StartDate.ToString("dd MMM yyyy") <i class="bi bi-arrow-right mx-1 text-muted"></i> @prod.EndDate.ToString("dd MMM")</td>
                                
                                @if (currentView == "headlines")
                                {
                                    <td><span class="badge bg-secondary">@prod.Category?.Name</span></td>
                                    <td class="fw-bold">@prod.Performances.Count Shows</td>
                                    <td>
                                        @if (prod.EndDate < DateTime.Today)
                                        {
                                            <span class="badge bg-dark">Completed</span>
                                        }
                                        else if (prod.StartDate <= DateTime.Today && prod.EndDate >= DateTime.Today)
                                        {

                                            <span class="badge bg-success">Live Now</span>
                                        }
                                        else
                                        {

                                            <span class="badge bg-primary">Upcoming</span>
                                        }
                                    </td>
                                }
                                else if (currentView == "crewing")
                                {
                                    var requiredRoles = prod.CrewAssignments.Count(c => c.IsRequired);
                                    var filledRequired = prod.CrewAssignments.Count(c => c.IsRequired && (c.MemberId != null || !string.IsNullOrEmpty(c.ExternalName)));
                                    var isGaps = requiredRoles > filledRequired;

                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="progress flex-grow-1" style="height: 8px;">
                                                <div class="progress-bar @(isGaps ? "bg-danger" : "bg-success")" role="progressbar" style="width: @(requiredRoles == 0 ? 100 : (filledRequired * 100 / requiredRoles))%"></div>
                                            </div>
                                            <span class="small fw-bold @(isGaps ? "text-danger" : "text-success")">@filledRequired / @requiredRoles</span>
                                        </div>
                                    </td>
                                    <td class="fw-bold">@prod.CrewAssignments.Count(c => c.MemberId != null || !string.IsNullOrEmpty(c.ExternalName)) Crew</td>
                                    <td class="text-center">
                                        @if (isGaps)
                                        {
                                            <span class="badge bg-danger"><i class="bi bi-exclamation-circle-fill me-1"></i>Crew Needed</span>
                                        }
                                        else
                                        {

                                            <span class="badge bg-success"><i class="bi bi-check-circle-fill"></i> Fully Staffed</span>
                                        }
                                    </td>
                                }
                                else if (currentView == "logistics")
                                {
                                    <td>@(string.IsNullOrEmpty(prod.HirerName) ? "In-House" : prod.HirerName)</td>
                                    <td class="fw-bold">@(prod.RunningTimeMinutes > 0 ? $"{prod.RunningTimeMinutes} mins" : "TBC")</td>
                                    <td>
                                        @if (prod.LockingMember != null)
                                        {
                                            <span class="badge bg-dark">@prod.LockingMember.FullName</span>
                                        }
                                        else
                                        {

                                            <span class="text-danger small fw-bold"><i class="bi bi-x-circle me-1"></i>Unassigned</span>
                                        }
                                    </td>
                                }
                            </tr>
                        }
                        @if (!GetFilteredProductions().Any())
                        {
                            <tr><td colspan="6" class="text-center py-4 text-muted fst-italic">No productions match the selected category filters.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

<style>
    @@media print {
        /* Override Blazor/Bootstrap layout wrappers that clip absolute positioning */
        html, body, main, .page, .content {
            height: auto !important;
            overflow: visible !important;
            position: static !important;
        }
            /* Hide everything by default */
            body * {
                visibility: hidden;
            }
        /* Make only the print area and its contents visible */
        .print-area, .print-area * {
            visibility: visible;
        }
        /* Anchor the print area to the top-left of the page */
        .print-area {
            position: absolute;
            left: 0;
            top: 0;
            width: 100%;
            margin: 0 !important;
            padding: 0 !important;
            border: none !important;
            box-shadow: none !important;
        }
        
        .d-print-none {
            display: none !important;
        }
    }
</style>

@code {
    private List<Production> activeProductions = new();
    private List<ProductionCategory> allCategories = new();
    private HashSet<int> selectedCategoryIds = new();
    private bool isLoading = true;
    private string currentView = "headlines";

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        using var context = await DbFactory.CreateDbContextAsync();
        
        allCategories = await context.Set<ProductionCategory>().OrderBy(c => c.SortOrder).ToListAsync();
        selectedCategoryIds = allCategories.Select(c => c.Id).ToHashSet();

        activeProductions = await context.Productions
            .AsNoTracking()
            .Include(p => p.Category)
            .Include(p => p.Performances)
            .Include(p => p.CrewAssignments)
            .Include(p => p.LockingMember)
            .Where(p => !p.IsArchived)
            .OrderBy(p => p.StartDate)
            .ToListAsync();

        isLoading = false;
    }

    private IEnumerable<Production> GetFilteredProductions()
    {
        return activeProductions.Where(p => selectedCategoryIds.Contains(p.CategoryId));
    }

    private void ToggleCategory(int catId, object? val)
    {
        bool isChecked = (bool)(val ?? false);
        if (isChecked) selectedCategoryIds.Add(catId);
        else selectedCategoryIds.Remove(catId);
    }

    private void SelectAllCategories() => selectedCategoryIds = allCategories.Select(c => c.Id).ToHashSet();
    private void ClearAllCategories() => selectedCategoryIds.Clear();

    /* Both Print and PDF use the browser's native print engine for perfect rendering */
    private async Task Print() => await JS.InvokeVoidAsync("window.print");

    private async Task ExportToExcel()
    {
        var html = await JS.InvokeAsync<string>("eval", "document.getElementById('seasonReportContent').outerHTML");
        var uri = "data:application/vnd.ms-excel;charset=utf-8," + Uri.EscapeDataString(html);
        await JS.InvokeVoidAsync("eval", $"var l = document.createElement('a'); l.href = '{uri}'; l.download = 'Season_Overview.xls'; l.click();");
    }

    private async Task ExportToWord()
    {
        var html = await JS.InvokeAsync<string>("eval", "document.getElementById('seasonReportContent').outerHTML");
        var header = "<html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word' xmlns='http://www.w3.org/TR/REC-html40'><head><meta charset='utf-8'></head><body>";
        var source = "data:application/vnd.ms-word;charset=utf-8," + Uri.EscapeDataString(header + html + "</body></html>");
        await JS.InvokeVoidAsync("eval", $"var l = document.createElement('a'); l.href = '{source}'; l.download = 'Season_Overview.doc'; l.click();");
    }
}