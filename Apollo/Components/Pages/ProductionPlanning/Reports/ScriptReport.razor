@page "/reports/Production/Scripts"
@using Apollo.Models
@using Apollo.Data
@using Microsoft.EntityFrameworkCore
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject IJSRuntime JS
@rendermode InteractiveServer

<PageTitle>Script Allocation Report</PageTitle>

<div class="container py-4 max-w-6xl d-print-none">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0 text-primary"><i class="bi bi-book me-2"></i>Script Allocation Report</h2>
            <p class="text-muted mb-0">Track issued script numbers across cast and technical crew.</p>
        </div>
        <button class="btn btn-outline-dark fw-bold" @onclick="Print"><i class="bi bi-printer me-2"></i>Print Report</button>
    </div>

    <div class="card border-0 shadow-sm mb-4 bg-light">
        <div class="card-body">
            <label class="small fw-bold">Select Production</label>
            <select class="form-select form-select-lg" @onchange="OnProductionSelected">
                <option value="0">-- All Active Productions --</option>
                @foreach (var p in productions)
                {
                    <option value="@p.Id">@p.Title (@p.StartDate.ToString("MMM yyyy"))</option>
                }
            </select>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-dark text-white small">
                    <tr>
                        <th class="ps-4">Script #</th>
                        <th>Assignee Name</th>
                        <th>Type</th>
                        <th>Role / Character</th>
                        <th>Production</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var script in scriptItems)
                    {
                        <tr>
                            <td class="ps-4 fw-bold text-primary fs-5">#(script.ScriptNumber)</td>
                            <td class="fw-bold">@script.AssigneeName</td>
                            <td><span class="badge @(script.Type == "Cast" ? "bg-info text-dark" : "bg-secondary")">@script.Type</span></td>
                            <td>@script.RoleOrCharacter</td>
                            <td class="text-muted">@script.ProductionTitle</td>
                        </tr>
                    }
                    @if (!scriptItems.Any())
                    {
                        <tr><td colspan="5" class="text-center py-4 text-muted fst-italic">No scripts currently issued.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    private List<Production> productions = new();
    private List<ScriptRecord> scriptItems = new();
    private int selectedProdId = 0;

    protected override async Task OnInitializedAsync()
    {
        using var context = await DbFactory.CreateDbContextAsync();
        productions = await context.Productions.Where(p => !p.IsArchived).ToListAsync();
        await LoadScripts();
    }

    private async Task OnProductionSelected(ChangeEventArgs e)
    {
        selectedProdId = int.Parse(e.Value?.ToString() ?? "0");
        await LoadScripts();
    }

    private async Task LoadScripts()
    {
        using var context = await DbFactory.CreateDbContextAsync();
        scriptItems.Clear();

        var castQuery = context.ProductionCasts.Include(c => c.Member).Include(c => c.Production).Where(c => !string.IsNullOrEmpty(c.ScriptNumber));
        var crewQuery = context.ProductionCrews.Include(c => c.Member).Include(c => c.Role).Include(c => c.Production).Where(c => !string.IsNullOrEmpty(c.ScriptNumber));

        if (selectedProdId > 0)
        {
            castQuery = castQuery.Where(c => c.ProductionId == selectedProdId);
            crewQuery = crewQuery.Where(c => c.ProductionId == selectedProdId);
        }

        foreach (var c in await castQuery.ToListAsync())
        {
            scriptItems.Add(new ScriptRecord
            {
                ScriptNumber = c.ScriptNumber!,
                AssigneeName = c.Member?.FullName ?? c.ExternalName ?? "Unknown",
                Type = "Cast",
                RoleOrCharacter = c.CharacterName,
                ProductionTitle = c.Production?.Title ?? ""
            });
        }

        foreach (var c in await crewQuery.ToListAsync())
        {
            scriptItems.Add(new ScriptRecord
            {
                ScriptNumber = c.ScriptNumber!,
                AssigneeName = c.Member?.FullName ?? c.ExternalName ?? "Unknown",
                Type = "Crew",
                RoleOrCharacter = c.Role?.Name ?? c.CustomRoleName ?? "Crew",
                ProductionTitle = c.Production?.Title ?? ""
            });
        }

        scriptItems = scriptItems.OrderBy(s => s.ScriptNumber).ToList();
    }

    private async Task Print() => await JS.InvokeVoidAsync("window.print");

    public class ScriptRecord
    {
        public string ScriptNumber { get; set; } = string.Empty;
        public string AssigneeName { get; set; } = string.Empty;
        public string Type { get; set; } = string.Empty;
        public string RoleOrCharacter { get; set; } = string.Empty;
        public string ProductionTitle { get; set; } = string.Empty;
    }
}