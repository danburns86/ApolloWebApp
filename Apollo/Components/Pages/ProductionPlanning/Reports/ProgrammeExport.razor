@page "/reports/Production/ProgrammeExport"
@using Apollo.Models
@using Apollo.Data
@using Microsoft.EntityFrameworkCore
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject IJSRuntime JS
@rendermode InteractiveServer

<div class="container py-4 max-w-5xl d-print-none">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0 text-primary"><i class="bi bi-file-earmark-word me-2"></i>Programme Data Export</h2>
            <p class="text-muted mb-0">Export formatted Cast, Creative, and Crew credits for publicity and programme publishing.</p>
        </div>
        <button class="btn btn-outline-primary fw-bold" @onclick="ExportToWord" disabled="@(selectedProd == null)"><i class="bi bi-download me-2"></i>Export Word Doc</button>
    </div>

    <div class="card border-0 shadow-sm mb-4 bg-light">
        <div class="card-body">
            <label class="small fw-bold">Select Production</label>
            <select class="form-select form-select-lg" @onchange="OnProductionSelected">
                <option value="0">-- Select Production --</option>
                @foreach (var p in productions)
                {
                    <option value="@p.Id">@p.Title (@p.StartDate.ToString("MMM yyyy"))</option>
                }
            </select>
        </div>
    </div>
</div>

@if (selectedProd != null)
{
    <div id="programmeReportContent" class="report-paper shadow-lg p-5 mx-auto bg-white mb-5">
        <h1 class="fw-bold border-bottom pb-2 mb-4">@selectedProd.Title</h1>
        
        <h4 class="fw-bold text-uppercase border-bottom pb-1 text-primary mb-3">Cast</h4>
        <table class="table table-borderless table-sm mb-4">
            <tbody>
                @foreach (var cast in castList)
                {
                    <tr>
                        <td class="fw-bold" style="width: 40%;">@cast.CharacterName</td>
                        <td>@(cast.Member?.FullName ?? cast.ExternalName ?? "TBC")</td>
                    </tr>
                }
            </tbody>
        </table>

        <h4 class="fw-bold text-uppercase border-bottom pb-1 text-primary mb-3">Production & Technical Team</h4>
        <table class="table table-borderless table-sm mb-4">
            <tbody>
                @foreach (var crew in selectedProd.CrewAssignments)
                {
                    <tr>
                        <td class="fw-bold" style="width: 40%;">@(crew.Role?.Name ?? crew.CustomRoleName)</td>
                        <td>@(crew.Member?.FullName ?? crew.ExternalName ?? "TBC")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<style>
    .report-paper {
        max-width: 210mm;
        min-height: 297mm;
    }
</style>

@code {
    private List<Production> productions = new();
    private Production? selectedProd;
    private List<ProductionCast> castList = new();

    protected override async Task OnInitializedAsync()
    {
        using var context = await DbFactory.CreateDbContextAsync();
        productions = await context.Productions.Where(p => !p.IsArchived).ToListAsync();
    }

    private async Task OnProductionSelected(ChangeEventArgs e)
    {
        int id = int.Parse(e.Value?.ToString() ?? "0");
        if (id == 0) { selectedProd = null; return; }

        using var context = await DbFactory.CreateDbContextAsync();
        selectedProd = await context.Productions
            .AsNoTracking()
            .Include(p => p.CrewAssignments).ThenInclude(c => c.Role)
            .Include(p => p.CrewAssignments).ThenInclude(c => c.Member)
            .FirstOrDefaultAsync(p => p.Id == id);

        if (selectedProd != null)
        {
            castList = await context.ProductionCasts.Include(c => c.Member).Where(c => c.ProductionId == id).ToListAsync();
        }
    }

    private async Task ExportToWord()
    {
        if (selectedProd == null) return;
        var filename = $"{selectedProd.Title}_Programme_Copy.doc";
        await JS.InvokeVoidAsync("eval", $@"
            var header = '<html xmlns:o=""urn:schemas-microsoft-com:office:office"" xmlns:w=""urn:schemas-microsoft-com:office:word"" xmlns=""http://www.w3.org/TR/REC-html40""><head><meta charset=""utf-8""></head><body>';
            var footer = '</body></html>';
            var sourceHTML = header + document.getElementById('programmeReportContent').innerHTML + footer;
            var source = 'data:application/vnd.ms-word;charset=utf-8,' + encodeURIComponent(sourceHTML);
            var fileLink = document.createElement('a');
            fileLink.href = source;
            fileLink.download = '{filename}';
            fileLink.click();
        ");
    }
}