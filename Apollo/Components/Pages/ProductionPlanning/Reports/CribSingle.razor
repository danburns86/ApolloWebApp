@page "/reports/Production/Crib"
@using Apollo.Models
@using Apollo.Data
@using Microsoft.EntityFrameworkCore
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject IJSRuntime JS
@rendermode InteractiveServer

<div class="container py-4 max-w-5xl d-print-none">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0 text-primary"><i class="bi bi-journal-text me-2"></i>Tech Crib Sheet</h2>
            <p class="text-muted mb-0">Master operational overview, rider, and access log for a single production.</p>
        </div>
        <button class="btn btn-outline-dark fw-bold" @onclick="Print" disabled="@(selectedProd == null)"><i class="bi bi-printer me-2"></i>Print Crib Sheet</button>
    </div>

    <div class="card border-0 shadow-sm mb-4 bg-light">
        <div class="card-body">
            <label class="small fw-bold">Select Production</label>
            <select class="form-select form-select-lg" @onchange="OnProductionSelected">
                <option value="0">-- Select Production --</option>
                @foreach (var p in productions)
                {
                    <option value="@p.Id">@p.Title (@p.StartDate.ToString("MMM yyyy"))</option>
                }
            </select>
        </div>
    </div>
</div>

@if (selectedProd != null)
{
    <div class="report-paper shadow-sm p-5 mx-auto bg-white mb-5 border border-2">
        <div class="border-bottom border-dark pb-3 mb-4 d-flex justify-content-between align-items-end">
            <div>
                <h1 class="fw-bold mb-0 text-uppercase">@selectedProd.Title</h1>
                <p class="fs-5 text-muted mb-0">Tech & Operational Crib Sheet</p>
            </div>
            <div class="text-end">
                <div class="fw-bold fs-6">Run Dates:</div>
                <div>@selectedProd.StartDate.ToString("dd MMM") - @selectedProd.EndDate.ToString("dd MMM yyyy")</div>
            </div>
        </div>

        <div class="row g-4 mb-4">
            <!-- LOGISTICS & ACCESS -->
            <div class="col-md-6">
                <div class="card h-100 border-dark rounded-0">
                    <div class="card-header bg-dark text-white fw-bold rounded-0">Access & Keyholders</div>
                    <div class="card-body small">
                        <table class="table table-sm table-borderless mb-0">
                            <tr><td class="fw-bold w-50">Load-In / Access Time:</td><td>@(selectedProd.AccessTime?.ToString("ddd dd MMM - HH:mm") ?? "TBC")</td></tr>
                            <tr><td class="fw-bold">Unlocking Keyholder:</td><td><span class="badge bg-warning text-dark fs-6">@(selectedProd.UnlockingMember?.FullName ?? "TBC")</span></td></tr>
                            <tr><td class="fw-bold">Locking Keyholder:</td><td><span class="badge bg-dark fs-6">@(selectedProd.LockingMember?.FullName ?? "TBC")</span></td></tr>
                            <tr><td class="fw-bold">In-House Crew Provided?</td><td>@(selectedProd.OurCrew ? "YES" : "NO")</td></tr>
                        </table>
                    </div>
                </div>
            </div>

            <!-- HIRER & TIMINGS -->
            <div class="col-md-6">
                <div class="card h-100 border-dark rounded-0">
                    <div class="card-header bg-dark text-white fw-bold rounded-0">Hirer & Timings</div>
                    <div class="card-body small">
                        <table class="table table-sm table-borderless mb-0">
                            <tr><td class="fw-bold w-50">Hirer / Company:</td><td>@(selectedProd.HirerName ?? "In-House")</td></tr>
                            <tr><td class="fw-bold">Hirer Contact:</td><td>@(selectedProd.HirerContact ?? "—")</td></tr>
                            <tr><td class="fw-bold">Est. Total Run Time:</td><td>@selectedProd.RunningTimeMinutes mins</td></tr>
                            <tr><td class="fw-bold">Interval Duration:</td><td>@selectedProd.IntervalMinutes mins</td></tr>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- TECH RIDER -->
        <div class="card border-dark rounded-0 mb-4">
            <div class="card-header bg-dark text-white fw-bold rounded-0">Technical Requirements & Spec Summary</div>
            <div class="card-body">
                <p class="mb-0" style="white-space: pre-wrap;">@(string.IsNullOrWhiteSpace(selectedProd.TechRequirements) ? "No technical requirements or rider provided." : selectedProd.TechRequirements)</p>
            </div>
        </div>

        <!-- FOH NOTES -->
        <div class="card border-dark rounded-0 mb-4">
            <div class="card-header bg-dark text-white fw-bold rounded-0">Front of House & Duty Manager Notes</div>
            <div class="card-body">
                <p class="mb-0" style="white-space: pre-wrap;">@(string.IsNullOrWhiteSpace(selectedProd.FOHNotes) ? "No specific FOH instructions." : selectedProd.FOHNotes)</p>
            </div>
        </div>

        <!-- PERFORMANCE OVERVIEW -->
        <h6 class="fw-bold border-bottom border-dark pb-1 text-uppercase mt-4 mb-3">Performance Schedule</h6>
        <table class="table table-sm table-bordered border-dark text-center align-middle mb-4">
            <thead class="table-light fw-bold">
                <tr>
                    <th class="text-start">Date</th>
                    <th>Curtain Up</th>
                    <th>Interval Start</th>
                    <th>Show End</th>
                    <th>Notes</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var perf in selectedProd.Performances.OrderBy(p => p.CurtainUp))
                {
                    <tr>
                        <td class="text-start fw-bold">@perf.CurtainUp.ToString("ddd dd MMM")</td>
                        <td>@perf.CurtainUp.ToString("HH:mm")</td>
                        <td>@(perf.IntervalTime?.ToString("HH:mm") ?? "—")</td>
                        <td>@(perf.EndTime?.ToString("HH:mm") ?? "—")</td>
                        <td class="text-muted small">@perf.PerformanceTitle</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<style>
    .report-paper { max-width: 210mm; min-height: 297mm; }
    @@media print {
        body * { visibility: hidden; }
        .report-paper, .report-paper * { visibility: visible; }
        .report-paper { position: absolute; left: 0; top: 0; width: 100%; border: none !important; box-shadow: none !important; }
        .d-print-none { display: none !important; }
        .bg-dark { background-color: #343a40 !important; color: white !important; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
        .bg-warning { background-color: #ffc107 !important; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
    }
</style>

@code {
    private List<Production> productions = new();
    private Production? selectedProd;

    protected override async Task OnInitializedAsync()
    {
        using var context = await DbFactory.CreateDbContextAsync();
        productions = await context.Productions.Where(p => !p.IsArchived).OrderByDescending(p => p.StartDate).ToListAsync();
    }

    private async Task OnProductionSelected(ChangeEventArgs e)
    {
        int id = int.Parse(e.Value?.ToString() ?? "0");
        if (id == 0) { selectedProd = null; return; }

        using var context = await DbFactory.CreateDbContextAsync();
        selectedProd = await context.Productions
            .AsNoTracking()
            .Include(p => p.UnlockingMember)
            .Include(p => p.LockingMember)
            .Include(p => p.Performances)
            .FirstOrDefaultAsync(p => p.Id == id);
    }

    private async Task Print() => await JS.InvokeVoidAsync("window.print");
}