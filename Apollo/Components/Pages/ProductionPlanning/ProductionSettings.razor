@page "/admin/production/settings"
@using Apollo.Models
@using Apollo.Data
@using Microsoft.EntityFrameworkCore
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode InteractiveServer
@inject IDbContextFactory<ApplicationDbContext> DbFactory

<PageTitle>Production Hub Settings</PageTitle>

<div class="container py-4 max-w-5xl">
    @* --- HEADER --- *@
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0">Production Hub Settings</h2>
            <p class="text-muted mb-0">Manage global categories, sort ordering, and meeting/rehearsal types.</p>
        </div>
        <div class="d-flex align-items-center gap-3">
            @if (showSavedMessage)
            {
                <div class="text-success fw-bold animate__animated animate__fadeIn">
                    <i class="bi bi-check-all me-1"></i>All Settings Saved!
                </div>
            }
            <button class="btn btn-primary fw-bold px-4 shadow-sm" @onclick="SaveAll">
                <i class="bi bi-save me-2"></i>Save All Changes
            </button>
        </div>
    </div>

    <div class="row g-4">
        @* --- PRODUCTION CATEGORIES --- *@
        <div class="col-md-7">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                    <h6 class="mb-0">Production Types & Sort Order</h6>
                    <button class="btn btn-sm btn-outline-light" @onclick="AddCategory">
                        <i class="bi bi-plus-lg me-1"></i>Add Type
                    </button>
                </div>
                <div class="card-body p-0">
                    <table class="table table-sm align-middle mb-0">
                        <thead class="bg-light small">
                            <tr>
                                <th style="width: 70px;" class="ps-3 text-center">Order</th>
                                <th>Name</th>
                                <th>Icon</th>
                                <th class="text-center">External?</th>
                                <th style="width: 90px;" class="text-end pe-3">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < categories.Count; i++)
                            {
                                var index = i;
                                var cat = categories[index];
                                <tr>
                                    <td class="ps-3 text-center">
                                        <input type="number" class="form-control form-control-sm text-center" @bind="cat.SortOrder" style="width: 55px;" />
                                    </td>
                                    <td><input type="text" class="form-control form-control-sm" @bind="cat.Name" placeholder="Type name..." /></td>
                                    <td><input type="text" class="form-control form-control-sm" @bind="cat.IconClass" placeholder="bi-star" /></td>
                                    <td class="text-center">
                                        <input type="checkbox" class="form-check-input" @bind="cat.IsExternal" />
                                    </td>
                                    <td class="text-end pe-3">
                                        <div class="btn-group btn-group-sm">
                                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => MoveCategoryUp(index)" disabled="@(index == 0)" title="Move Up">
                                                <i class="bi bi-arrow-up"></i>
                                            </button>
                                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => MoveCategoryDown(index)" disabled="@(index == categories.Count - 1)" title="Move Down">
                                                <i class="bi bi-arrow-down"></i>
                                            </button>
                                            <button class="btn btn-sm btn-outline-danger" @onclick="() => categories.Remove(cat)" title="Delete">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    @if (!categories.Any())
                    {
                        <div class="p-4 text-center text-muted small italic">No categories defined.</div>
                    }
                </div>
            </div>
        </div>

        @* --- REHEARSAL / MEETING TYPES --- *@
        <div class="col-md-5">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <h6 class="mb-0">Meeting & Rehearsal Types</h6>
                    <button class="btn btn-sm btn-outline-light" @onclick="() => eventTypes.Add(new ProductionEventType())">
                        <i class="bi bi-plus-lg me-1"></i>Add Event
                    </button>
                </div>
                <div class="card-body p-0">
                    <table class="table table-sm mb-0 align-middle">
                        <tbody>
                            @foreach (var et in eventTypes)
                            {
                                <tr>
                                    <td class="ps-3"><input type="text" class="form-control form-control-sm border-0" @bind="et.Name" placeholder="Event name (e.g. Read-Through, Tech, Rehearsal)..." /></td>
                                    <td class="text-end pe-3">
                                        <button class="btn btn-sm text-danger" @onclick="() => eventTypes.Remove(et)">
                                            <i class="bi bi-x-lg"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    @if (!eventTypes.Any())
                    {
                        <div class="p-4 text-center text-muted small italic">No event types defined.</div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private List<ProductionCategory> categories = new();
    private List<ProductionEventType> eventTypes = new();
    private bool showSavedMessage = false;

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        using var context = await DbFactory.CreateDbContextAsync();
        categories = await context.ProductionCategories
            .AsNoTracking()
            .OrderBy(c => c.SortOrder)
            .ThenBy(c => c.Name)
            .ToListAsync();

        eventTypes = await context.ProductionEventTypes
            .AsNoTracking()
            .OrderBy(e => e.Name)
            .ToListAsync();
    }

    private void AddCategory()
    {
        int nextOrder = categories.Any() ? categories.Max(c => c.SortOrder) + 1 : 1;
        categories.Add(new ProductionCategory { SortOrder = nextOrder });
    }

    private void MoveCategoryUp(int index)
    {
        if (index <= 0) return;
        var temp = categories[index];
        categories[index] = categories[index - 1];
        categories[index - 1] = temp;
        ReindexCategories();
    }

    private void MoveCategoryDown(int index)
    {
        if (index >= categories.Count - 1) return;
        var temp = categories[index];
        categories[index] = categories[index + 1];
        categories[index + 1] = temp;
        ReindexCategories();
    }

    private void ReindexCategories()
    {
        for (int i = 0; i < categories.Count; i++)
        {
            categories[i].SortOrder = i + 1;
        }
    }

    private async Task SaveAll()
    {
        using var context = await DbFactory.CreateDbContextAsync();

        // 1. SYNC CATEGORIES
        var dbCats = await context.ProductionCategories.ToListAsync();
        context.ProductionCategories.RemoveRange(dbCats.Where(db => !categories.Any(ui => ui.Id == db.Id)));

        foreach (var uiCat in categories)
        {
            if (uiCat.Id == 0)
            {
                context.ProductionCategories.Add(uiCat);
            }
            else
            {
                var dbCat = dbCats.FirstOrDefault(db => db.Id == uiCat.Id);
                if (dbCat != null) context.Entry(dbCat).CurrentValues.SetValues(uiCat);
            }
        }

        // 2. SYNC EVENT TYPES
        var dbETs = await context.ProductionEventTypes.ToListAsync();
        context.ProductionEventTypes.RemoveRange(dbETs.Where(db => !eventTypes.Any(ui => ui.Id == db.Id)));

        foreach (var uiET in eventTypes)
        {
            if (uiET.Id == 0)
            {
                context.ProductionEventTypes.Add(uiET);
            }
            else
            {
                var dbET = dbETs.FirstOrDefault(db => db.Id == uiET.Id);
                if (dbET != null) context.Entry(dbET).CurrentValues.SetValues(uiET);
            }
        }

        await context.SaveChangesAsync();
        await Load();

        showSavedMessage = true;
        StateHasChanged();

        await Task.Delay(3000);
        showSavedMessage = false;
        StateHasChanged();
    }
}