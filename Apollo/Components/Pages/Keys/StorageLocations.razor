@page "/setup/locations"
@using Apollo.Models
@using Apollo.Data
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Administrator")]
@rendermode InteractiveServer

<PageTitle>Storage Locations</PageTitle>

<h2>Manage Storage Locations</h2>
<p class="text-muted">Define physical locations where keys and bunches are kept (e.g., Foyer Cupboard, Tech Safe).</p>
<hr />

<div class="row">
    <div class="col-md-4">
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-primary text-white">Add New Location</div>
            <div class="card-body">
                <EditForm Model="NewLocation" OnValidSubmit="AddLocation" FormName="AddLocationForm">
                    <DataAnnotationsValidator />
                    <div class="mb-3">
                        <label class="form-label fw-bold">Location Name <span class="text-danger">*</span></label>
                        <InputText @bind-Value="NewLocation.Name" class="form-control" placeholder="e.g., Main Foyer Cupboard" />
                        <ValidationMessage For="() => NewLocation.Name" class="text-danger" />
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Save Location</button>
                </EditForm>
            </div>
        </div>
    </div>

    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-body p-0">
                <table class="table table-striped table-hover mb-0 align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th class="ps-3">Location Name</th>
                            <th class="text-end pe-3">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!LocationsList.Any())
                        {
                            <tr><td colspan="2" class="text-center py-4 text-muted">No locations found.</td></tr>
                        }
                        else
                        {
                            @foreach (var loc in LocationsList)
                            {
                                <tr>
                                    <td class="ps-3 fw-bold">@loc.Name</td>
                                    <td class="text-end pe-3">
                                        <button class="btn btn-sm btn-outline-primary me-2 shadow-sm" @onclick="() => ViewContents(loc.Id)">
                                            <i class="bi bi-box-seam"></i> View Contents
                                        </button>
                                        <button type="button" class="btn btn-sm btn-outline-danger shadow-sm" @onclick="() => ArchiveLocation(loc.Id)">
                                            <i class="bi bi-archive"></i> Archive
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@if (ShowContentsModal)
{
    <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog modal-dialog-scrollable">
            <div class="modal-content shadow-lg border-primary">
                <div class="modal-header bg-dark text-white">
                    <h5 class="modal-title">Cabinet Contents</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => ShowContentsModal = false"></button>
                </div>
                <div class="modal-body p-0">
                    <div class="bg-light px-3 py-2 border-bottom fw-bold text-uppercase small text-muted">Loose Keys In Stock</div>
                    <ul class="list-group list-group-flush mb-3">
                        @foreach (var key in CabinetKeys)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <div><strong>@key.Lock?.LockCode @key.SequenceNumber</strong> <br /><span class="small text-muted">@key.Lock?.Name</span></div>
                                <span class="badge bg-success">In Stock</span>
                            </li>
                        }
                        @if (!CabinetKeys.Any())
                        {
                            <li class="list-group-item text-center text-muted small fst-italic">No loose keys.</li>
                        }
                    </ul>

                    <div class="bg-light px-3 py-2 border-bottom border-top fw-bold text-uppercase small text-muted">Bunches In Stock</div>
                    <ul class="list-group list-group-flush">
                        @foreach (var bunch in CabinetBunches)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <strong>@bunch.Name</strong>
                                <span class="badge bg-dark">Bunch</span>
                            </li>
                        }
                        @if (!CabinetBunches.Any())
                        {
                            <li class="list-group-item text-center text-muted small fst-italic">No bunches.</li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    </div>
}

@code {
    public StorageLocation NewLocation { get; set; } = new();
    private List<StorageLocation> LocationsList = new();

    private bool ShowContentsModal = false;
    private List<KeyRecord> CabinetKeys = new();
    private List<Bunch> CabinetBunches = new();

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData()
    {
        using var context = await DbFactory.CreateDbContextAsync();
        LocationsList = await context.StorageLocations.AsNoTracking().Where(s => s.IsActive).OrderBy(s => s.Name).ToListAsync();
    }

    private async Task ViewContents(int locId)
    {
        using var context = await DbFactory.CreateDbContextAsync();
        
        // Find keys that are physically in this location and not issued or on a bunch
        var attachedIds = await context.KeyBunchAssignments.Where(a => a.RemovedDate == null).Select(a => a.KeyRecordId).ToListAsync();
        CabinetKeys = await context.Keys
            .Include(k => k.Lock)
            .Where(k => k.StorageLocationId == locId && k.Status == "In Stock" && !attachedIds.Contains(k.Id))
            .OrderBy(k => k.Lock!.LockCode).ThenBy(k => k.SequenceNumber)
            .ToListAsync();

        // Find bunches whose home is this location and are not currently checked out
        CabinetBunches = await context.Bunches
            .Where(b => b.StorageLocationId == locId && b.IssuedToName == null && !b.IsLost && b.IsActive)
            .OrderBy(b => b.Name)
            .ToListAsync();

        ShowContentsModal = true;
    }

    private async Task ArchiveLocation(int id)
    {
        using var context = await DbFactory.CreateDbContextAsync();
        var locToArchive = await context.StorageLocations.FindAsync(id);
        if (locToArchive != null) { locToArchive.IsActive = false; await context.SaveChangesAsync(); await LoadData(); }
    }

    private async Task AddLocation()
    {
        using var context = await DbFactory.CreateDbContextAsync();
        context.StorageLocations.Add(NewLocation); await context.SaveChangesAsync();
        NewLocation = new StorageLocation(); await LoadData();
    }
}